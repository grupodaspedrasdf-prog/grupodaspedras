rules_version = '2';

// Regras do Grupo das Pedras
// Cole em: Console do Firebase > Firestore Database > aba "Regras" > Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    match /grupos/{grupoId} {

      // qualquer aparelho autenticado (anonimamente, pelo app) lê e atualiza o cabeçalho do grupo
      allow read, write: if request.auth != null;

      // cadastro de jogadores: livre para quem usa o app
      match /cadastro/{doc} {
        allow read, write: if request.auth != null;
      }

      // noites: podem ser criadas e lidas, NUNCA alteradas ou apagadas.
      // É a regra "não há reabertura" garantida pelo servidor.
      match /noites/{noiteId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasAll(['cod','resumo','totais'])
                      && request.resource.data.resumo is list;
        allow update, delete: if false;
      }
    }

    // nada mais no banco é acessível
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
